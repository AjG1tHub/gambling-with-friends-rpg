function keyFromHeader(h) { h = String(h).trim().replace(/[^A-Za-z0-9]+/g, ''); return h.charAt(0).toLowerCase() + h.slice(1); }
function headerFromKey(k) { k = String(k); return k.charAt(0).toUpperCase() + k.slice(1); }
function parseCell(v) {
  if (v === '' || v === null || v === undefined) return undefined;
  if (typeof v !== 'string') return v;
  var s = v.trim();
  if (s === '') return undefined;
  if (s === 'TRUE' || s === 'true') return true;
  if (s === 'FALSE' || s === 'false') return false;
  if ((s.charAt(0) === '{' && s.charAt(s.length - 1) === '}') || (s.charAt(0) === '[' && s.charAt(s.length - 1) === ']')) {
    try { return JSON.parse(s); } catch (e) { return s; }
  }
  if (/^-?\d+(\.\d+)?$/.test(s)) return Number(s);
  return s;
}
function formatCell(v) {
  if (v === undefined || v === null) return '';
  if (typeof v === 'object') return JSON.stringify(v);
  return v;
}
function isSettingsGrid(grid) {
  var h = grid[0] || [];
  return String(h[0]).trim().toLowerCase() === 'key' && String(h[1]).trim().toLowerCase() === 'value';
}
// 2-D cell values of one tab → the object / array the game expects.
function gridToValue(grid) {
  if (!grid || !grid.length) return null;
  if (isSettingsGrid(grid)) {
    var obj = {};
    for (var r = 1; r < grid.length; r++) { var k = String(grid[r][0]).trim(); if (!k) continue; var v = parseCell(grid[r][1]); if (v !== undefined) obj[k] = v; }
    return obj;
  }
  var heads = grid[0].map(function (h) { return String(h).trim(); });
  if (!heads.some(function (h) { return h; })) return null;
  var rows = [];
  for (var i = 1; i < grid.length; i++) {
    var row = {}, any = false;
    for (var c = 0; c < heads.length; c++) {
      if (!heads[c]) continue;
      var val = parseCell(grid[i][c]);
      if (val === undefined) continue;
      any = true;
      var m = /^W([1-9])$/.exec(heads[c]);
      if (m) { row.weights = row.weights || {}; row.weights[m[1]] = val; } else row[keyFromHeader(heads[c])] = val;
    }
    if (any) rows.push(row);
  }
  return rows;
}
function rowKey(row) { if (!row) return ''; var k = row.id !== undefined ? row.id : row.label !== undefined ? row.label : row.name !== undefined ? row.name : row.tier !== undefined ? row.tier : row.themeId; return k === undefined ? '' : String(k); }
function fieldsOf(row) {
  var out = [];
  for (var k in row) { if (k === 'weights' && row.weights && typeof row.weights === 'object') { for (var t in row.weights) out.push('W' + t); } else out.push(headerFromKey(k)); }
  return out;
}
function cellFor(row, header) {
  var m = /^W([1-9])$/.exec(header);
  if (m) return row.weights ? formatCell(row.weights[m[1]]) : '';
  return formatCell(row[keyFromHeader(header)]);
}
/**
