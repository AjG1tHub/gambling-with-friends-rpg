    if (p.create) bits.push('new tab');
    if (p.addColumns.length) bits.push('columns ' + p.addColumns.join(', '));
    if (p.appendRows.length) bits.push(p.appendRows.length + ' row' + (p.appendRows.length === 1 ? '' : 's') + ' (' + p.appendRows.map(function (r) { return r[0]; }).join(', ') + ')');
    if (p.fillCells.length) bits.push(p.fillCells.length + ' blank cell' + (p.fillCells.length === 1 ? '' : 's') + ' filled in the new columns');
