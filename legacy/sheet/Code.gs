  var rows = def || [];
  var wanted = [];
  rows.forEach(function (row) { fieldsOf(row).forEach(function (h) { if (wanted.indexOf(h) < 0) wanted.push(h); }); });
  if (!wanted.length) wanted = (emptyHeaders || []).slice();
  if (!exists) { plan.create = true; plan.headers = wanted; rows.forEach(function (row) { plan.appendRows.push(wanted.map(function (h) { return cellFor(row, h); })); }); return plan; }
  var heads = grid[0].map(function (h) { return String(h).trim(); });
  var lower = heads.map(function (h) { return keyFromHeader(h).toLowerCase(); });
  var all = heads.slice();
  wanted.forEach(function (h) { if (lower.indexOf(keyFromHeader(h).toLowerCase()) < 0) { plan.addColumns.push(h); all.push(h); lower.push(keyFromHeader(h).toLowerCase()); } });
