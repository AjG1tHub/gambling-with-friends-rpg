/**
 * Gambling With Friends — Google Sheet endpoint (Apps Script).
 * GENERATED by tools/build-apps-script.mjs — edit sheet/Code.template.gs, not Code.gs.
 *
 * What it does
 *   GET  /exec                      → { ok:true, tabs:{ Config:{…}, Games:[…], … } }   (the game reads this)
 *   POST /exec {action:'ledger',row} → appends one row to the Ledger tab               (the game writes this)
 *   Menu “GWF” in the Sheet          → “Add missing tabs & rows” brings an older Sheet up to date
 *                                      with the game's built-in defaults. It only ADDS; it never changes
 *                                      or deletes anything you typed.
 *
 * Sheet layout it understands
 *   • Settings tabs (Config, Board, Loans, …): column A = Key, column B = Value.
 *   • Row tabs (Games, Wheel_Good, …): row 1 = headers, one row per item. Header “GoldRate” becomes goldRate.
 *   • A cell holding {…} or […] is read as JSON (Params, Odds, QuickBets…).
 *   • Wheel_Jail uses columns W1–W4 for the per-tier weights.
 *   • Empty cells are left out, so the game's built-in value applies.
 *
 * Install: Sheet → Extensions → Apps Script → paste this whole file over Code.gs → Deploy → Manage deployments →
 * edit the existing deployment → Version: New version → Deploy. (Keeping the same deployment keeps the same /exec URL.)
 */
var LEDGER_TAB = 'Ledger';
var SKIP_TABS = ['Ledger', 'Sheet1', 'README'];
var DEFAULTS = /*__DEFAULTS__*/{};
var EMPTY_HEADERS = /*__EMPTY_HEADERS__*/{};

// ── pure helpers (no Sheet access; unit-tested in test/unit/apps-script.test.mjs) ──────────────
function keyFromHeader(h) { h = String(h).trim().replace(/[^A-Za-z0-9]+/g, ''); return h.charAt(0).toLowerCase() + h.slice(1); }
function headerFromKey(k) { k = String(k); return k.charAt(0).toUpperCase() + k.slice(1); }
function parseCell(v) {
  if (v === '' || v === null || v === undefined) return undefined;
  if (typeof v !== 'string') return v;
  var s = v.trim();
  if (s === '') return undefined;
  if (s === 'TRUE' || s === 'true') return true;
  if (s === 'FALSE' || s === 'false') return false;
  if ((s.charAt(0) === '{' && s.charAt(s.length - 1) === '}') || (s.charAt(0) === '[' && s.charAt(s.length - 1) === ']')) {
    try { return JSON.parse(s); } catch (e) { return s; }
  }
  if (/^-?\d+(\.\d+)?$/.test(s)) return Number(s);
  return s;
}
function formatCell(v) {
  if (v === undefined || v === null) return '';
  if (typeof v === 'object') return JSON.stringify(v);
  return v;
}
function isSettingsGrid(grid) {
  var h = grid[0] || [];
  return String(h[0]).trim().toLowerCase() === 'key' && String(h[1]).trim().toLowerCase() === 'value';
}
// 2-D cell values of one tab → the object / array the game expects.
function gridToValue(grid) {
  if (!grid || !grid.length) return null;
  if (isSettingsGrid(grid)) {
    var obj = {};
    for (var r = 1; r < grid.length; r++) { var k = String(grid[r][0]).trim(); if (!k) continue; var v = parseCell(grid[r][1]); if (v !== undefined) obj[k] = v; }
    return obj;
  }
  var heads = grid[0].map(function (h) { return String(h).trim(); });
  if (!heads.some(function (h) { return h; })) return null;
  var rows = [];
  for (var i = 1; i < grid.length; i++) {
    var row = {}, any = false;
    for (var c = 0; c < heads.length; c++) {
      if (!heads[c]) continue;
      var val = parseCell(grid[i][c]);
      if (val === undefined) continue;
      any = true;
      var m = /^W([1-9])$/.exec(heads[c]);
      if (m) { row.weights = row.weights || {}; row.weights[m[1]] = val; } else row[keyFromHeader(heads[c])] = val;
    }
    if (any) rows.push(row);
  }
  return rows;
}
function rowKey(row) { if (!row) return ''; var k = row.id !== undefined ? row.id : row.label !== undefined ? row.label : row.name !== undefined ? row.name : row.tier !== undefined ? row.tier : row.themeId; return k === undefined ? '' : String(k); }
function fieldsOf(row) {
  var out = [];
  for (var k in row) { if (k === 'weights' && row.weights && typeof row.weights === 'object') { for (var t in row.weights) out.push('W' + t); } else out.push(headerFromKey(k)); }
  return out;
}
function cellFor(row, header) {
  var m = /^W([1-9])$/.exec(header);
  if (m) return row.weights ? formatCell(row.weights[m[1]]) : '';
  return formatCell(row[keyFromHeader(header)]);
}
/**
 * Work out what to add to one tab so it carries everything in the defaults. Never changes a filled cell.
 * Returns { create, headers, addColumns:[header], appendRows:[[…]], fillCells:[{row, col, value}] } (row/col 0-based in the grid).
 */
function planTab(tabName, grid, def, emptyHeaders) {
  var plan = { tab: tabName, create: false, headers: null, addColumns: [], appendRows: [], fillCells: [] };
  var exists = grid && grid.length && grid[0].some(function (h) { return String(h).trim(); });
  if (def && !Array.isArray(def)) {                       // settings tab
    if (!exists) { plan.create = true; plan.headers = ['Key', 'Value']; for (var k in def) plan.appendRows.push([k, formatCell(def[k])]); return plan; }
    var have = {};
    for (var r = 1; r < grid.length; r++) have[String(grid[r][0]).trim()] = true;
    for (var key in def) if (!have[key]) plan.appendRows.push([key, formatCell(def[key])]);
    return plan;
  }
  var rows = def || [];
  var wanted = [];
  rows.forEach(function (row) { fieldsOf(row).forEach(function (h) { if (wanted.indexOf(h) < 0) wanted.push(h); }); });
  if (!wanted.length) wanted = (emptyHeaders || []).slice();
  if (!exists) { plan.create = true; plan.headers = wanted; rows.forEach(function (row) { plan.appendRows.push(wanted.map(function (h) { return cellFor(row, h); })); }); return plan; }
  var heads = grid[0].map(function (h) { return String(h).trim(); });
  var lower = heads.map(function (h) { return keyFromHeader(h).toLowerCase(); });
  var all = heads.slice();
  wanted.forEach(function (h) { if (lower.indexOf(keyFromHeader(h).toLowerCase()) < 0) { plan.addColumns.push(h); all.push(h); lower.push(keyFromHeader(h).toLowerCase()); } });
  var current = gridToValue(grid) || [], byKey = {};
  // map key → grid row index (blank rows are skipped by gridToValue, so walk the grid directly)
  for (var g = 1; g < grid.length; g++) { var one = gridToValue([grid[0], grid[g]]); if (one && one.length) byKey[rowKey(one[0])] = g; }
  rows.forEach(function (row) {
    var k = rowKey(row);
    if (!(k in byKey)) { plan.appendRows.push(all.map(function (h) { return cellFor(row, h); })); return; }
    // existing row: only fill cells in the columns being added now
    plan.addColumns.forEach(function (h) { var v = cellFor(row, h); if (v !== '') plan.fillCells.push({ row: byKey[k], col: all.indexOf(h), value: v }); });
  });
  return plan;
}
function planAll(grids, defaults, emptyHeaders) {
  var plans = [];
  for (var tab in defaults) {
    if (SKIP_TABS.indexOf(tab) >= 0) continue;
    var p = planTab(tab, grids[tab] || null, defaults[tab], (emptyHeaders || {})[tab]);
    if (p.create || p.addColumns.length || p.appendRows.length || p.fillCells.length) plans.push(p);
  }
  return plans;
}
function describePlans(plans) {
  if (!plans.length) return 'Nothing to add — the Sheet already has every tab, row and column the game knows about.';
  return plans.map(function (p) {
    var bits = [];
    if (p.create) bits.push('new tab');
    if (p.addColumns.length) bits.push('columns ' + p.addColumns.join(', '));
    if (p.appendRows.length) bits.push(p.appendRows.length + ' row' + (p.appendRows.length === 1 ? '' : 's') + ' (' + p.appendRows.map(function (r) { return r[0]; }).join(', ') + ')');
    if (p.fillCells.length) bits.push(p.fillCells.length + ' blank cell' + (p.fillCells.length === 1 ? '' : 's') + ' filled in the new columns');
    return p.tab + ': ' + bits.join('; ');
  }).join('\n');
}
function ledgerRow(row, now) {
  row = row || {};
  return [now, String(row.type || ''), row.playerId == null ? '' : String(row.playerId), JSON.stringify(row)];
}

// ── Sheet access ───────────────────────────────────────────────────────────────────────────────
function readGrids_() {
  var out = {};
  SpreadsheetApp.getActiveSpreadsheet().getSheets().forEach(function (sh) {
    var name = sh.getName();
    if (SKIP_TABS.indexOf(name) >= 0) return;
    out[name] = sh.getLastRow() && sh.getLastColumn() ? sh.getDataRange().getValues() : [];
  });
  return out;
}
function json_(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }

function doGet() {
  try {
    var grids = readGrids_(), tabs = {};
    for (var name in grids) { var v = gridToValue(grids[name]); if (v !== null) tabs[name] = v; }
    return json_({ ok: true, tabs: tabs, generatedAt: new Date().toISOString() });
  } catch (e) { return json_({ ok: false, error: String(e) }); }
}

function doPost(e) {
  try {
    var body = JSON.parse((e && e.postData && e.postData.contents) || '{}');
    if (body.action !== 'ledger') return json_({ ok: false, error: 'unknown action' });
    var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName(LEDGER_TAB);
    if (!sh) { sh = ss.insertSheet(LEDGER_TAB); sh.appendRow(['ts', 'type', 'playerId', 'json']); }
    sh.appendRow(ledgerRow(body.row, new Date()));
    return json_({ ok: true });
  } catch (err) { return json_({ ok: false, error: String(err) }); }
}

function onOpen() {
  SpreadsheetApp.getUi().createMenu('GWF')
    .addItem('Preview what is missing', 'gwfPreviewMissing')
    .addItem('Add missing tabs & rows', 'gwfAddMissing')
    .addToUi();
}
function gwfPreviewMissing() { SpreadsheetApp.getUi().alert('GWF — missing from this Sheet', describePlans(planAll(readGrids_(), DEFAULTS, EMPTY_HEADERS)), SpreadsheetApp.getUi().ButtonSet.OK); }
function gwfAddMissing() {
  var ui = SpreadsheetApp.getUi(), ss = SpreadsheetApp.getActiveSpreadsheet();
  var plans = planAll(readGrids_(), DEFAULTS, EMPTY_HEADERS);
  if (!plans.length) { ui.alert(describePlans(plans)); return; }
  if (ui.alert('GWF — add these?', describePlans(plans) + '\n\nNothing you typed will be changed.', ui.ButtonSet.OK_CANCEL) !== ui.Button.OK) return;
  plans.forEach(function (p) {
    var sh = ss.getSheetByName(p.tab) || ss.insertSheet(p.tab);
    if (p.create) { sh.getRange(1, 1, 1, p.headers.length).setValues([p.headers]).setFontWeight('bold'); sh.setFrozenRows(1); }
    var width = sh.getLastColumn();
    p.addColumns.forEach(function (h) { width += 1; sh.getRange(1, width).setValue(h).setFontWeight('bold'); });
    p.fillCells.forEach(function (c) { sh.getRange(c.row + 1, c.col + 1).setValue(c.value); });
    if (p.appendRows.length) { var n = p.appendRows[0].length; sh.getRange(sh.getLastRow() + 1, 1, p.appendRows.length, n).setValues(p.appendRows); }
  });
  ui.alert('Done. Reload the config in the GM window (⚙ Settings → Save + Reload Config).');
}
