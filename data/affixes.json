{
  "_about": "The affix pool (SPEC.md › Gear and item generation, the affix table). Every rolled piece of gear carries affixes drawn from this list for its slot. `kind` is what the code switches on; `slots` is where it may roll; `target` says what the affix is keyed to: 'family' (one of the five game families), 'game' (one named game of the 36), 'familyOrGame' (the generator picks), 'region' (one of the five regions) or null. Values are read from balance.json `affix.*` at generation time (`valueKeys` names the min/max pair, `valueKey` a fixed tunable) and scaled by `affix.tierScale` per region tier above 1. Names: the first affix on an item gives the prefix, the second the suffix (Weighted Iron Helm of the Dealer). `effect` is a fixed sub-kind the consuming module switches on (odds effects for the items adapter, movement effects for the movement module, utility effects for the characters module). Shape of a rolled affix on an Item: { id, kind, effect?, target: {family}|{game}|{region}|null, value, text }.",
  "families": ["dice", "cards", "wheels", "nerve", "picks"],
  "regions": ["strip", "docks", "blackwood", "caldera", "citadel"],
  "slotRules": {
    "_about": "Which affix kinds an item of a slot must carry first, in order; the rest of its affix count is filled from the pool for the slot without repeating an affix id.",
    "weapon":    ["damage"],
    "offhand":   ["damage"],
    "spell":     ["odds"],
    "helmet":    ["guard", "utility"],
    "torso":     ["guard", "utility"],
    "pants":     ["guard", "utility"],
    "gloves":    ["guard", "utility"],
    "boots":     ["movement", "guard"],
    "ring":      [],
    "necklace":  [],
    "cape":      []
  },
  "affixes": [
    { "id": "cruel",     "kind": "damage", "slots": ["weapon", "offhand", "spell", "ring"], "target": "familyOrGame", "valueKeys": ["damageMin", "damageMax"], "unit": "fraction",
      "prefixes": ["Cruel", "Savage", "Vicious", "Biting"], "suffixes": ["of Cruelty", "of the Butcher", "of Spite"], "text": "+{pct} damage with {target}" },
    { "id": "keen",      "kind": "damage", "slots": ["weapon", "offhand", "spell", "ring"], "target": "game", "valueKeys": ["damageMin", "damageMax"], "unit": "fraction",
      "prefixes": ["Keen", "Honed", "Sharpened"], "suffixes": ["of the Edge", "of Precision"], "text": "+{pct} damage with {target}" },

    { "id": "dealer",    "kind": "odds", "effect": "peek",     "slots": ["weapon", "spell", "ring", "gloves"], "target": "game", "valueKey": "oddsUses", "unit": "uses",
      "prefixes": ["Knowing", "Watchful", "Marked"], "suffixes": ["of the Dealer", "of the Peephole", "of Second Sight"], "text": "One extra peek per use in {target}" },
    { "id": "mulligan",  "kind": "odds", "effect": "reroll",   "slots": ["weapon", "spell", "ring", "gloves"], "target": "game", "valueKey": "oddsUses", "unit": "uses",
      "prefixes": ["Forgiving", "Second-Chance", "Loose"], "suffixes": ["of the Mulligan", "of the Do-Over", "of the Croupier"], "text": "One extra reroll per use in {target}" },
    { "id": "safepick",  "kind": "odds", "effect": "safepick", "slots": ["weapon", "spell", "ring", "gloves"], "target": "game", "valueKey": "oddsUses", "unit": "uses",
      "prefixes": ["Sure", "Careful", "Steady"], "suffixes": ["of the Safe Hand", "of Certainty", "of the Pit"], "text": "One extra safe pick per use in {target}" },

    { "id": "thrifty",   "kind": "stake", "slots": ["pants", "necklace"], "target": "family", "valueKeys": ["stakeMin", "stakeMax"], "unit": "fraction",
      "prefixes": ["Thrifty", "Frugal", "Miserly", "Lean"], "suffixes": ["of Thrift", "of the Cheap Seat", "of the Small Bet"], "text": "{target} items stake {pct} less" },

    { "id": "stone",     "kind": "guard", "slots": ["helmet", "torso", "pants", "gloves", "boots"], "target": "family", "valueKeys": ["guardMin", "guardMax"], "unit": "fraction",
      "prefixes": ["Stone", "Weighted", "Leaden"], "suffixes": ["of Stone", "of the Wall", "of Standing"], "text": "{pct} less damage from {target}" },
    { "id": "bastion",   "kind": "guard", "slots": ["helmet", "torso", "pants", "gloves", "boots"], "target": "family", "valueKeys": ["guardMin", "guardMax"], "unit": "fraction",
      "prefixes": ["Bulwark", "Ironbound", "Bastion"], "suffixes": ["of the Vault", "of the Bastion", "of the Closed Door"], "text": "{pct} less damage from {target}" },
    { "id": "mirrored",  "kind": "ward", "slots": ["torso", "necklace"], "target": "family", "valueKeys": ["wardMin", "wardMax"], "unit": "fraction",
      "prefixes": ["Mirrored", "Reflective", "Silvered"], "suffixes": ["of the Mirror", "of the Refund", "of Half Measures"], "text": "A losing stake against {target} refunds {pct}" },

    { "id": "quick",     "kind": "tempo", "slots": ["helmet", "ring"], "target": null, "valueKeys": ["tempoMin", "tempoMax"], "unit": "turns",
      "prefixes": ["Quick", "Hasty", "Restless"], "suffixes": ["of Tempo", "of Haste", "of the Short Fuse"], "text": "Class active cooldown {n} turn(s) shorter" },

    { "id": "greedy",    "kind": "economy", "effect": "gold",   "slots": ["necklace", "boots"], "target": null, "valueKey": "economyGold", "unit": "fraction",
      "prefixes": ["Greedy", "Gilded", "Grasping"], "suffixes": ["of Greed", "of the Purse", "of the Bank"], "text": "+{pct} Gold from KOs" },
    { "id": "studious",  "kind": "economy", "effect": "xp",     "slots": ["necklace", "boots"], "target": null, "valueKey": "economyXp", "unit": "fraction",
      "prefixes": ["Studious", "Learned", "Seasoned"], "suffixes": ["of Lessons", "of the Scholar", "of Experience"], "text": "+{pct} XP" },
    { "id": "fortunate", "kind": "economy", "effect": "rarity", "slots": ["necklace", "boots"], "target": "region", "valueKey": "economyRarity", "unit": "rarity steps",
      "prefixes": ["Fortunate", "Lucky", "Blessed"], "suffixes": ["of Fortune", "of the Find", "of Plenty"], "text": "Loot rolls {n} rarity higher in {target}" },

    { "id": "dieup",       "kind": "movement", "effect": "dieUp",       "slots": ["boots"], "target": null, "value": 1, "unit": "die sizes", "modes": ["dice"],
      "prefixes": ["Long-Stride", "Bounding"], "suffixes": ["of the Bigger Die", "of Reach"], "text": "Movement die one size up" },
    { "id": "twodice",     "kind": "movement", "effect": "twoDice",     "slots": ["boots"], "target": null, "value": 2, "unit": "dice", "modes": ["dice"],
      "prefixes": ["Split", "Twin"], "suffixes": ["of Two Dice", "of the Pair"], "text": "Roll two smaller dice instead of one" },
    { "id": "rerollones",  "kind": "movement", "effect": "rerollOnes",  "slots": ["boots"], "target": null, "value": 1, "unit": "rerolls", "modes": ["dice"],
      "prefixes": ["Unsnake-Eyed", "Patient"], "suffixes": ["of No Ones", "of the Second Roll"], "text": "Reroll a 1" },
    { "id": "keepstop",    "kind": "movement", "effect": "keepStop",    "slots": ["boots"], "target": null, "value": 1, "unit": "on/off", "modes": ["dice"],
      "prefixes": ["Sure-Footed", "Braking"], "suffixes": ["of the Early Stop", "of Restraint"], "text": "Keep the stop-early right on a big die" },
    { "id": "homebonus",   "kind": "movement", "effect": "homeBonus",   "slots": ["boots"], "target": null, "value": 1, "unit": "hexes", "modes": ["dice", "wheel", "card"],
      "prefixes": ["Homeward", "Local"], "suffixes": ["of Home Turf", "of the Regular"], "text": "+1 movement in your own region" },
    { "id": "nostumble",   "kind": "movement", "effect": "noStumble",   "slots": ["boots"], "target": null, "value": 1, "unit": "on/off", "modes": ["wheel"],
      "prefixes": ["Even", "Unstumbling"], "suffixes": ["of Balance", "of the Steady Spin"], "text": "The movement wheel loses Stumble" },
    { "id": "extrasprint", "kind": "movement", "effect": "extraSprint", "slots": ["boots"], "target": null, "value": 1, "unit": "segments", "modes": ["wheel"],
      "prefixes": ["Sprinting", "Racing"], "suffixes": ["of the Second Sprint", "of Speed"], "text": "A second Sprint segment on the movement wheel" },
    { "id": "peektop",     "kind": "movement", "effect": "peekTop",     "slots": ["boots"], "target": null, "value": 1, "unit": "cards", "modes": ["card"],
      "prefixes": ["Peeking", "Curious"], "suffixes": ["of the Top Card", "of Foresight"], "text": "Peek the top colour card" },
    { "id": "drawtwo",     "kind": "movement", "effect": "drawTwo",     "slots": ["boots"], "target": null, "value": 2, "unit": "cards", "modes": ["card"],
      "prefixes": ["Two-Handed", "Choosy"], "suffixes": ["of Draw Two", "of the Choice"], "text": "Draw two colour cards, keep one" },
    { "id": "range6",      "kind": "movement", "effect": "range6",      "slots": ["boots"], "target": null, "value": 6, "unit": "hexes", "modes": ["card"],
      "prefixes": ["Far-Seeing", "Wide-Eyed"], "suffixes": ["of Range Six", "of the Long Look"], "text": "Card boots look 6 hexes for a colour" },
    { "id": "moredoubles", "kind": "movement", "effect": "moreDoubles", "slots": ["boots"], "target": null, "value": 1, "unit": "cards", "modes": ["card"],
      "prefixes": ["Doubled", "Stacked"], "suffixes": ["of Doubles", "of the Second Nearest"], "text": "More double cards in the colour deck" },

    { "id": "nerveseconds", "kind": "utility", "effect": "nerveSeconds", "slots": ["helmet"], "target": null, "valueKey": "helmetNerveSeconds", "unit": "seconds",
      "prefixes": ["Cool-Headed", "Composed", "Unhurried"], "suffixes": ["of Nerve", "of the Long Breath", "of the Clock"], "text": "+{n} seconds on your shot clock" },
    { "id": "stout",        "kind": "utility", "effect": "maxHealth",    "slots": ["torso"], "target": null, "valueKey": "torsoMaxHealth", "unit": "Health",
      "prefixes": ["Stout", "Hearty", "Thick"], "suffixes": ["of Vigour", "of the Oak", "of Blood"], "text": "+{n} max Health while worn" },
    { "id": "stakecap",     "kind": "utility", "effect": "stakeCap",     "slots": ["pants"], "target": null, "valueKey": "pantsStakeCap", "unit": "Health",
      "prefixes": ["Capped", "Prudent", "Hemmed"], "suffixes": ["of the Cap", "of the Limit", "of Restraint"], "text": "A losing stake costs at most {n} Health" },
    { "id": "lightfingers", "kind": "utility", "effect": "peek",         "slots": ["gloves"], "target": null, "valueKey": "glovesPeeks", "unit": "peeks",
      "prefixes": ["Light-Fingered", "Nimble", "Sly"], "suffixes": ["of the Peek", "of the Marked Card", "of the Tell"], "text": "{n} free hidden-pick peek per night" }
  ]
}
